POSTGRES_DB=hr_reports
POSTGRES_USER=hr_app
POSTGRES_PASSWORD=replace_with_strong_password
DATABASE_URL=postgres://hr_app:replace_with_strong_password@postgres:5432/hr_reports?sslmode=disable
DEBTSTER_API=https://replace_with_debtster_api
DEBSTER_KEY=replace_with_debtster_api_key
# true = тестовые РП, вакансии и стажёры без обращений к Debtster
DEBTSTER_MOCK=false
HTTP_ADDR=:8080
APP_SECRET=replace_with_long_random_secret
SUPERADMIN_LOGIN=superadmin
SUPERADMIN_PASSWORD=replace_with_strong_superadmin_password
STATIC_DIR=/app/web
APP_PORT=6770
NGROK_AUTHTOKEN=replace_with_ngrok_authtoken
NGROK_DOMAIN=your-domain.ngrok-free.dev
DOCKER_NETWORK=hr_network

# Optional AI extraction for free-form candidate answers.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-nano
OPENAI_API_BASE_URL=https://api.openai.com/v1
OPENAI_TIMEOUT_SECONDS=30
WHATSAPP_MODE=production


# Server-to-server key used by Debtster to read trainee correction requests.
DEBTSTER_INTEGRATION_KEY=replace_with_shared_integration_key

# Bitrix24 incoming HR requests webhook base URL (without crm.item.list.json).
BITRIX_WEBHOOK_BASE_URL=https://1collekt.bitrix24.kz/rest/956/replace_with_bitrix_webhook_key
